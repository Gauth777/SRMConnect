# Frontend (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only: required by /api/admin/live. Never prefix this with NEXT_PUBLIC_.
# Use the project's new Supabase secret key (preferred) or legacy service_role key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Temporary fixed administrator login. Keep ADMIN_PASSWORD only in .env.local / hosting secrets.
ADMIN_EMAIL=allenbarr2609@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_FIXED_ADMIN_PASSWORD
