// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Technical placeholder model to allow Prisma Client compilation and code generation.
// No migrations should be run for this model; it will be replaced once the database schema is pulled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model UserProfile {
  id       String     @id @db.Uuid
  email    String     @unique
  fullName String
  role     UserRole
  status   UserStatus @default(ACTIVE)

  avatarUrl String?

  phone String?

  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?

  faculty Faculty?

  @@map("user_profiles")
}

model Student {
  id String @id @db.Uuid

  registrationNo String @unique

  department String

  program String

  year Int

  section String?

  cgpa Float?

  graduationYear Int?

  user UserProfile @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("students")
}

model Faculty {
  id String @id @db.Uuid

  employeeId String @unique

  department String

  designation String

  cabin String?

  specialization String?

  user UserProfile @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("faculty")
}
