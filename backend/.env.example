NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Prisma/NestJS runtime connection. Supabase transaction pooler is preferred
# for application traffic; keep ?pgbouncer=true when using port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session/direct connection used by Prisma CLI introspection and admin tooling.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@REGION.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
